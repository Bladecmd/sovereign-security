# Sovereign Security Foundation V0.1
# Environment Configuration Template
# Copy this file to .env and configure for your local/deployment environment.
# NEVER commit .env to version control.

# Application Environment
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Service Identification
SERVICE_NAME=sovereign-security
SERVICE_VERSION=0.1.0

# Sovereign Security API Key / Shared Secrets (Placeholders only)
SOVEREIGN_SECURITY_API_KEY=YOUR_SECURITY_API_KEY_HERE
SOVEREIGN_OS_API_URL=http://localhost:3000
SOVEREIGN_OS_SHARED_SECRET=YOUR_SOVEREIGN_OS_SHARED_SECRET_HERE

# Metro Task Force (MTF) Integration (Placeholders only)
MTF_INGEST_ENABLED=true
MTF_SHARED_SECRET=YOUR_MTF_SHARED_SECRET_HERE

# Risk & Threat Engine Thresholds
THREAT_FAILED_LOGIN_THRESHOLD=5
THREAT_FAILED_LOGIN_WINDOW_SECONDS=300
RISK_HIGH_SEVERITY_THRESHOLD=75
RISK_CRITICAL_SEVERITY_THRESHOLD=90

# Audit Storage & Hash Chaining
AUDIT_PERSISTENCE_PATH=./data/audit.log
AUDIT_HASH_ALGORITHM=sha256
