# Sovereign Security .gitignore
# Strictly prevent secret exposure and build clutter

# Environment & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.pfx
secrets/
private/

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build Outputs
dist/
build/
coverage/
*.tsbuildinfo

# Operating System
.DS_Store
Thumbs.db
Desktop.ini

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo
