{
  "name": "sovereign-security",
  "version": "1.0.0",
  "description": "Sovereign Security Platform V1.0 — Integrated Zero-Trust Identity, Security, Risk, and Governance Layer",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "npx tsx tests/run-all.ts",
    "test:coverage": "npx tsx --experimental-test-coverage tests/run-all.ts",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "server": "node --import tsx src/server/server.ts"
  },
  "keywords": [
    "sovereign",
    "security",
    "identity",
    "governance",
    "zero-trust",
    "ai-security",
    "threat-detection"
  ],
  "author": "Sovereign Security Core Team",
  "license": "UNLICENSED",
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
